APP_NAME="SUN ENTERPRICES"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Colombo
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development can use sqlite or MySQL.
# Production MUST use MySQL 8.x.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hardware_system
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@sunenterprise.lk"
MAIL_FROM_NAME="${APP_NAME}"

# Text.lk production SMS. Never commit real keys.
SMS_ENABLED=false
SMS_PROVIDER=textlk
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ENDPOINT=https://app.text.lk/api/v3/sms/send
SMS_VIEW_ENDPOINT=https://app.text.lk/api/v3/sms

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Set AWS_ENDPOINT for S3-compatible storage such as Backblaze B2 or Wasabi.
AWS_ENDPOINT=

# Hourly database backups. Leave BACKUP_OFFSITE_DISK empty for local-only
# backups in development; production must set it, or a dead server takes the
# backups with it.
BACKUP_OFFSITE_DISK=
BACKUP_OFFSITE_PATH=database-backups
BACKUP_KEEP_LOCAL_DAYS=2
BACKUP_KEEP_OFFSITE_DAYS=30
BACKUP_COMPRESS=true

VITE_APP_NAME="${APP_NAME}"

# ---------- Production example (VPS / Nginx) ----------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://sunenterprise.lk
# APP_FORCE_HTTPS=true
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sun_enterprise
# DB_USERNAME=sun_enterprise
# DB_PASSWORD=change-me
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.sunenterprise.lk
# QUEUE_CONNECTION=database
# MAIL_MAILER=smtp
# SMS_ENABLED=true
# SMS_PROVIDER=textlk
# SMS_API_KEY=your-textlk-api-token
# SMS_SENDER_ID=SunEnt
# BACKUP_OFFSITE_DISK=s3
# AWS_ACCESS_KEY_ID=your-storage-key
# AWS_SECRET_ACCESS_KEY=your-storage-secret
# AWS_BUCKET=sunenterprise-backups
# AWS_DEFAULT_REGION=us-east-005
# AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com
